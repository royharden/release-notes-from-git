{
  "name": "release-notes-from-git",
  "version": "0.1.0",
  "private": true,
  "description": "Release-notes generator whose every bullet cites commits and is checked in code before export.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "lint": "eslint .",
    "test": "vitest run",
    "build": "vite build",
    "eval": "node scripts/eval.ts --split synthetic"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.49.4",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "9.27.0",
    "@testing-library/dom": "10.4.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.15.21",
    "@types/react": "18.3.23",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.4.1",
    "eslint": "9.27.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "16.1.0",
    "jsdom": "26.1.0",
    "typescript": "5.8.3",
    "typescript-eslint": "8.33.0",
    "vite": "6.3.5",
    "vitest": "3.2.4"
  }
}
